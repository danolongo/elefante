(version 1)
(deny default)
(allow process-exec process-fork)
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow file-read-metadata)
(allow file-write* (literal "/dev/null"))
(allow file-read* (subpath (param "ROOT")) (subpath (param "TEMP")))
(allow file-write* (subpath (param "ROOT")) (subpath (param "TEMP")))
(allow file-read* (literal (param "TRAVERSE_0")))
(allow file-read* (literal (param "TRAVERSE_1")))
(allow file-read* (literal (param "TRAVERSE_2")))
(allow file-read* (subpath (param "READ_0")))
(deny file-write* (require-all (subpath (param "ROOT")) (regex #"/\.[Gg][Ii][Tt](/|$)")))
(deny file-read* (require-all (subpath (param "ROOT")) (regex #"/(\.env(\.[^/]*)?|\.netrc|\.npmrc|\.git-credentials|credentials(\.toml)?|id_rsa[^/]*|[^/]*\.[Pp][Ee][Mm]|[^/]*\.[Kk][Ee][Yy])(/|$)")))
(deny file-read* file-write* (require-all (subpath (param "ROOT")) (regex #"/\.elefante(/|$)")))
(deny file-read* (require-all (subpath (param "ROOT")) (regex #"/\.ssh(/|$)")))
(deny file-write* (subpath (param "RO_0")))
(deny file-read* file-write* (subpath (param "HIDDEN_0")))
(allow mach-lookup (global-name "com.apple.system.logger") (global-name "com.apple.system.notification_center") (global-name "com.apple.system.opendirectoryd.libinfo"))
(allow mach-lookup (global-name "com.apple.cfprefsd.daemon") (global-name "com.apple.cfprefsd.agent") (global-name "com.apple.bsd.dirhelper"))
(allow network* (local unix-socket (subpath (param "ROOT"))) (remote unix-socket (subpath (param "ROOT"))) (local unix-socket (subpath (param "TEMP"))) (remote unix-socket (subpath (param "TEMP"))))
